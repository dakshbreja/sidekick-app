[
  {
    "name": "start_practice_item",
    "description": "Record the actual question/options, versioned source and student-stated confidence BEFORE asking for or accepting an answer. Null confidence means not stated. Persist and read back revision 1 before continuing. No retroactive confidence imports.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "course": {
          "type": "string",
          "enum": [
            "BUSN5000",
            "MGMT4280",
            "MGMT5560",
            "MGMT5850",
            "LAND2510",
            "BUSN3040"
          ]
        },
        "term_id": {
          "type": "string",
          "enum": [
            "fall-2026"
          ]
        },
        "sandbox": {
          "type": "boolean",
          "default": false
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "item": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "item_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "material_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "material_id",
                "revision",
                "url"
              ]
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600
                  },
                  "distractor_type": {
                    "type": "string",
                    "enum": [
                      "concept_confusion",
                      "calculation",
                      "sign",
                      "units",
                      "reading",
                      "unspecified"
                    ]
                  }
                },
                "required": [
                  "id",
                  "text"
                ]
              }
            },
            "confidence": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "confidence_stated_at": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "recording_agent": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "review_of": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "item_id",
            "session_id",
            "source",
            "question",
            "options",
            "confidence",
            "confidence_stated_at",
            "recording_agent"
          ]
        }
      },
      "required": [
        "course",
        "expected_revision",
        "idempotency_key",
        "item"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
